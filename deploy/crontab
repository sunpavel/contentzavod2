# ── Контент-завод FoodGenius: 3 слота в день, ограниченный объём ──
# Время — Москва. «Посты и видео»: видео-ролики + текстовые посты.
# Установка:  crontab deploy/crontab     (проверить: crontab -l)
# Логи:       logs/zavod_<дата>.log
# Путь к репозиторию подставь свой, если он не /home/user/contentzavod2.
# Форматы: demo (промо-видео) | creator (UGC-видео) | text (текст: Threads+IG).
CRON_TZ=Europe/Moscow
# ВАЖНО: cron не видит твой обычный PATH — укажи папку с node (узнать: `dirname $(which node)`).
PATH=/usr/local/bin:/usr/bin:/bin:/opt/node22/bin

#   мин час  день мес дн.нед   команда
    0   8    *    *   *        /home/user/contentzavod2/tools/scheduled_run.sh morning demo    1
    30  12   *    *   *        /home/user/contentzavod2/tools/scheduled_run.sh noon    text    1
    50  17   *    *   *        /home/user/contentzavod2/tools/scheduled_run.sh evening creator 1
