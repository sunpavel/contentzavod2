# ============================================================
#  CONTENT ZAVOD — переменные окружения
#  Скопируй в .env и заполни. .env в git НЕ коммитится.
# ============================================================

# ---- n8n / Postgres (инфраструктура) ----
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# Внешний URL n8n (нужен для вебхуков kill-switch). Для прода — https-домен.
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Moscow
N8N_ENCRYPTION_KEY=change_me_to_a_long_random_string

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me
POSTGRES_DB=n8n

# ---- LLM (тексты, сценарии, хуки) ----
# Контент-завод по умолчанию работает на Claude.
ANTHROPIC_API_KEY=sk-ant-...
# Модели: дорого/умно — claude-sonnet-4-6 ; дёшево/массово — claude-haiku-4-5
LLM_MODEL_SMART=claude-sonnet-4-6
LLM_MODEL_FAST=claude-haiku-4-5
# Альтернатива (дешевле, OpenAI-совместимый): DeepSeek. Если задан — scriptwriter
# использует его вместо Anthropic.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Генерация видео (Фаза 2) ----
# fal.ai — агрегатор моделей видео (Veo / Kling) с async + webhook
FAL_KEY=
# Какую модель видео дёргаем (см. docs/02-credentials.md)
FAL_VIDEO_MODEL=fal-ai/kling-video/v2/master/text-to-video
# Creatomate — сборка/монтаж ролика по шаблону
CREATOMATE_API_KEY=
CREATOMATE_TEMPLATE_ID=
# Лимит трат на генерацию в день (USD) — cost guard
DAILY_VIDEO_BUDGET_USD=20

# ---- Viral mining / reverse-engineering (WF1/WF2) ----
# EnsembleData — ОСНОВНОЙ источник трендов TikTok+Instagram (есть velocity). tools/mine_ensembledata.mjs
ENSEMBLEDATA_TOKEN=
# Apify — фолбэк-скрейпер (конкуренты/хэштеги)
APIFY_TOKEN=
APIFY_TT_ACTOR=clockworks~tiktok-scraper
APIFY_IG_ACTOR=apify~instagram-scraper
# Транскрибация ролика-источника для реверс-инжиниринга
ASSEMBLYAI_API_KEY=

# ---- Публикация ----
# Blotato (облако, на одобренных приложениях — без аппрувов площадок). Приоритетный.
BLOTATO_API_KEY=
BLOTATO_ACCOUNTS=          # instagram:ID,tiktok:ID,youtube:ID  (узнать: tools/blotato_accounts.mjs)
# Postiz (self-host, опенсорс, $0). Деплой: docs/07-postiz.md
POSTIZ_URL=                 # база до /public/v1, напр. https://postiz.твойдомен/public/v1
POSTIZ_API_KEY=             # Settings > Developers > Public API
POSTIZ_CHANNELS=            # id:tiktok,id:instagram,id:youtube  (узнать: tools/postiz_channels.mjs)
# Альтернатива: upload-post.com
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=foodgenius

# ---- Google Sheets (панель/очередь) ----
# ID таблицы (из URL). Доступ настраивается через credential в n8n.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=queue

# ---- Telegram (дайджест + kill-switch) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Продукт (для CTA в текстах) ----
PRODUCT_NAME="FoodGenius AI"
PRODUCT_BOT=@foodgenius_ai_bot
PRODUCT_URL=https://foodgenius-ai-production.up.railway.app
