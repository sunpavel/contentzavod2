{
  "name": "WF1 - Trends -> Ideas",
  "nodes": [
    {
      "parameters": {
        "content": "## WF1 — Тренды → Идеи\nРаз в день: тянем сигналы трендов, LLM предлагает идеи роликов → строки status=idea.\nПромпт: prompts/trend-research.md\n\n➡️ Вставь channel-dna в ноду 'Channel DNA'.\n➡️ Источники сигналов расширь (YouTube Data API, Google Trends). Здесь — Reddit как пример.",
        "height": 240,
        "width": 380
      },
      "id": "wf1-note",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [180, 60]
    },
    {
      "parameters": { "rule": { "interval": [ { "field": "days", "triggerAtHour": 6 } ] } },
      "id": "wf1-trigger",
      "name": "Daily 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 360]
    },
    {
      "parameters": {
        "url": "https://www.reddit.com/r/MealPrepSunday/top.json?t=week&limit=15",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "User-Agent", "value": "content-zavod/1.0" } ] },
        "options": {}
      },
      "id": "wf1-signals",
      "name": "Trend signals (Reddit)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 360]
    },
    {
      "parameters": {
        "assignments": { "assignments": [
          { "id": "s1", "name": "trend_signals", "value": "={{ ($json.data?.children || []).map(c => c.data.title).join('\\n') }}", "type": "string" },
          { "id": "s2", "name": "channel_dna", "value": "ВСТАВЬ СЮДА содержимое config/channel-dna.yaml", "type": "string" },
          { "id": "s3", "name": "top_performers", "value": "(подтянется из WF6: форматы/темы с высоким perf_score)", "type": "string" },
          { "id": "s4", "name": "n", "value": "5", "type": "string" }
        ] },
        "options": {}
      },
      "id": "wf1-prep",
      "name": "Channel DNA + signals",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
          { "name": "anthropic-version", "value": "2023-06-01" },
          { "name": "content-type", "value": "application/json" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $env.LLM_MODEL_SMART }}\",\n  \"max_tokens\": 2000,\n  \"system\": \"Ты контент-стратег коротких видео. CHANNEL DNA: {{ $json.channel_dna }}. Учитывай что заходило: {{ $json.top_performers }}. Без медицинских обещаний.\",\n  \"messages\": [ { \"role\": \"user\", \"content\": \"Сигналы трендов:\\n{{ $json.trend_signals }}\\n\\nПредложи {{ $json.n }} идей. Верни ТОЛЬКО JSON-массив объектов с ключами topic, idea, format_id, hook_draft, trend_score, product_tie.\" } ]\n}",
        "options": {}
      },
      "id": "wf1-llm",
      "name": "Claude - ideas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 360]
    },
    {
      "parameters": {
        "jsItems": "// распарсить массив идей и превратить в строки очереди\nlet txt = items[0].json?.content?.[0]?.text || '[]';\nconst m = txt.match(/\\[[\\s\\S]*\\]/); if (m) txt = m[0];\nlet arr = []; try { arr = JSON.parse(txt); } catch(e) { arr = []; }\nconst now = new Date().toISOString();\nreturn arr.map((a, idx) => ({ json: {\n  id: Date.now() + '-' + idx,\n  status: 'idea',\n  source_type: 'generate',\n  priority: 3,\n  trend_score: a.trend_score ?? '',\n  format_id: a.format_id ?? '',\n  topic: a.topic ?? '',\n  idea: a.idea ?? '',\n  hook: a.hook_draft ?? '',\n  platforms: 'youtube,instagram,threads',\n  created_at: now,\n  notes: a.product_tie ?? ''\n}}));",
        "mode": "runOnceForAllItems",
        "language": "javaScript"
      },
      "id": "wf1-parse",
      "name": "Ideas -> rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 360]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "={{ $env.GOOGLE_SHEET_ID }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "={{ $env.GOOGLE_SHEET_TAB }}", "mode": "name" },
        "columns": { "mappingMode": "autoMapInputData", "value": {} },
        "options": {}
      },
      "id": "wf1-append",
      "name": "Append ideas",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1360, 360],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" } }
    }
  ],
  "connections": {
    "Daily 06:00": { "main": [ [ { "node": "Trend signals (Reddit)", "type": "main", "index": 0 } ] ] },
    "Trend signals (Reddit)": { "main": [ [ { "node": "Channel DNA + signals", "type": "main", "index": 0 } ] ] },
    "Channel DNA + signals": { "main": [ [ { "node": "Claude - ideas", "type": "main", "index": 0 } ] ] },
    "Claude - ideas": { "main": [ [ { "node": "Ideas -> rows", "type": "main", "index": 0 } ] ] },
    "Ideas -> rows": { "main": [ [ { "node": "Append ideas", "type": "main", "index": 0 } ] ] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "tags": [ { "name": "content-zavod" } ]
}
